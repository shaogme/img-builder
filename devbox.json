{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": [
    "cdrkit@latest",
    "wimlib@latest",
    "dos2unix@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "build": "bash scripts/build.sh all",
      "build:base": "bash scripts/build.sh base",
      "build:gnu": "bash scripts/build.sh gnu",
      "build:msvc": "bash scripts/build.sh msvc",
      "clean": "rm -rf build"
    }
  }
}
